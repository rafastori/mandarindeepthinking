{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/generate.js": {
      "maxDuration": 60,
      "includeFiles": "lib/**"
    },
    "api/test.js": {
      "includeFiles": "lib/**"
    },
    "api/debug.js": {
      "includeFiles": "lib/**"
    }
  }
}